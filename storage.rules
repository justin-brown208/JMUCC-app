rules_version = '2';

// The only Storage objects are the OC-uploaded source PDFs (rulebook + FAQ),
// which every participant is entitled to read — the document viewer (PAGES.md
// §6) hands over the whole PDF, so the content is not secret. So `documents/**`
// is publicly readable; the searchDocuments function reads the same objects
// server-side via the Admin SDK. No client writes anywhere; OC uploads the PDFs
// through the Firebase console. Everything outside `documents/` is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /documents/{doc=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
